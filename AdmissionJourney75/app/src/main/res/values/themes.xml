<resources>
    <style name="Theme.AdmissionJourney75" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">#0F172A</item>
        <item name="android:navigationBarColor">#0F172A</item>
        <item name="android:windowBackground">#0F172A</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Shown instantly on cold start (Android 12+ native, compat on older versions), then
         hands off to Theme.AdmissionJourney75 once installSplashScreen()'s content is ready. -->
    <style name="Theme.Admission.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0F172A</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.AdmissionJourney75</item>
    </style>
</resources>
